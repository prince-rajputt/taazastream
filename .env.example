# TaazaStream configuration. Copy to .env (never commit .env).
# Everything here is optional — sensible defaults are built in.

NODE_ENV=production
# Listen on all interfaces so phones/TVs on the LAN can connect.
HOST=0.0.0.0
PORT=3000
# Friendly name shown in the admin dashboard and on the LAN.
SERVER_NAME=

# Local SQLite database (primary store, works offline). Relative paths are from the repo root.
DATABASE_URL=file:./data/taazastream.db
DATA_DIR=./data
CACHE_DIR=./cache
BACKUP_DIR=./backups

# Optional initial media folders, separated by ";" — you can also add them in Admin → Media folders.
# Example: MEDIA_ROOT=D:\TaazaStream\Movies;D:\TaazaStream\Series
MEDIA_ROOT=
# Scan all media folders when the server starts.
SCAN_ON_START=false

# Leave empty to auto-detect (system PATH, then the bundled FFmpeg build).
FFMPEG_PATH=
FFPROBE_PATH=

LOG_LEVEL=info
LOG_PRETTY=false

# LAN discovery: http://taazastream.local:3000 (the IP address always works too).
MDNS_ENABLED=true

# Optional: create the first admin from here instead of the browser (remove the password afterwards).
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_TTL_HOURS=168

# Security: admin APIs only answer private/LAN addresses unless this is true (not recommended).
ALLOW_PUBLIC_ADMIN=false
# Extra allowed browser origins, comma separated (only needed for development).
CORS_ORIGINS=
# Set to true only when running behind a reverse proxy you control.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Optional cloud (Supabase). TaazaStream works fully without these.
# Used only for metadata backup, artwork and sync — never for video playback.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Required for cloud sync/backup. NEVER expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=taazastream-artwork
